{
  "name": "@halftome/szamlazz-client",
  "version": "4.0.0",
  "type": "module",
  "description": "Javascript client for using szamlazz.hu API",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/half2me/szamlazz-client.git"
  },
  "author": "halftome@gmail.com",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/half2me/szamlazz-client/issues"
  },
  "homepage": "https://github.com/half2me/szamlazz-client#readme",
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "xmlbuilder2": "^4.0.3"
  }
}
