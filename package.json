{
  "name": "@halftome/szamlazz-client",
  "version": "4.0.0",
  "type": "module",
  "description": "Javascript client for using szamlazz.hu API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "test:all": "vitest run",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/half2me/szamlazz-client.git"
  },
  "author": "halftome@gmail.com",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/half2me/szamlazz-client/issues"
  },
  "homepage": "https://github.com/half2me/szamlazz-client#readme",
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "xmlbuilder2": "^4.0.3"
  }
}
