{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
